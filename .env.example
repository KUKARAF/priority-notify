# Database
DATABASE_URL=sqlite+aiosqlite:///./data/priority_notify.db

# OIDC / Authentik (confidential client)
AUTHENTIK_ISSUER_URL=https://auth.osmosis.page
AUTHENTIK_CLIENT_ID=your-client-id
AUTHENTIK_CLIENT_SECRET=your-client-secret
AUTHENTIK_REDIRECT_URI=https://notifications.osmosis.page/auth/callback

# Application
SECRET_KEY=change-me-to-a-random-secret
ALLOWED_HOSTS=notifications.osmosis.page,localhost,127.0.0.1

# Optional
LOG_LEVEL=INFO
CORS_ORIGINS=

# MCP server (/api/mcp) + OAuth sign-in for AI assistants — see README
PUBLIC_URL=https://notifications.osmosis.page
MCP_ENABLED=true
OAUTH_SERVER_ENABLED=true
OAUTH_CIMD_ALLOWED_HOSTS=claude.ai,chatgpt.com
# Dynamic client registration for clients without CIMD (e.g. LiteLLM); empty = off
OAUTH_DCR_ALLOWED_REDIRECT_HOSTS=litellm.osmosis.page
